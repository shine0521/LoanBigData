# ============================================
# 根 .gitignore（LoanBigData 仓库全局）
# ============================================

# Node 通用
node_modules/
dist/
build/
out/
coverage/
.cache/
.nyc_output/

# 环境变量（敏感信息，绝不入库）
.env
.env.local
.env.*.local
!.env.example

# 日志
*.log
logs/
*.pid

# 系统文件
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml

# 数据库文件
*.sqlite
*.sqlite3
*.db
data/

# 临时文件
tmp/
temp/
*.bak
*~

# TypeScript
*.tsbuildinfo

# 锁文件：保留 package-lock.json（npm 官方推荐）
yarn.lock
pnpm-lock.yaml