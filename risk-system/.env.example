# 风险评分系统 — 环境变量示例
# 复制为各服务实际使用的 .env 文件

# ---------- 后端 risk-admin/server/.env ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=risk123456
DB_DATABASE=risk_score
JWT_SECRET=risk-admin-secret-change-me
PORT=3000

# ---------- 前端代理（开发期 vite.config 已内置，无需额外配置） ----------
# H5:   /api  -> http://localhost:3000
# Web:  /api  -> http://localhost:3000
# Web:  /ws   -> http://localhost:3000  (socket.io namespace /ws/admin/notify)

# ---------- 默认管理员账号（开发用，后端内存校验） ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
