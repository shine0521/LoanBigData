# 生产环境变量模板（CloudBase Run 后端服务「环境变量」中逐项配置）
# 不要在仓库中提交真实值；CloudBase 控制台配置后注入容器。

# 数据库驱动：生产用 mysql
DB_DRIVER=mysql

# CloudBase MySQL 数据库连接（在 CloudBase「数据库」控制台获取内网/外网地址）
DB_HOST=填CloudBase-MySQL地址
DB_PORT=3306
DB_USER=root
DB_PASSWORD=填你的MySQL密码
DB_DATABASE=risk_admin

# JWT 密钥：务必改为随机长字符串（可用 `openssl rand -base64 48` 生成）
JWT_SECRET=请改为随机长字符串

# 服务端口（CloudBase Run 容器监听端口，与 Dockerfile EXPOSE 一致）
PORT=3000
