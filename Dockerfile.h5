# 风险评分系统 - H5 用户端 (Vue3 + Vite 静态站点)
# 适用：腾讯云 CloudBase Run 容器部署（nginx 托管静态 + 反代 /api 到后端）
# build context: 仓库根目录（CloudBase Run「Dockerfile 名称」填 ./Dockerfile.h5）
FROM node:20.18-alpine AS builder
WORKDIR /app
COPY risk-score-h5/package*.json ./
RUN npm ci
COPY risk-score-h5/ ./
RUN npm run build
# 构建产物在 /app/dist

FROM nginx:1.27.4-alpine
# 默认后端地址（CloudBase Run 环境变量可覆盖）
ENV API_TARGET="https://risk-api-278112-4-1450481727.sh.run.tcloudbase.com"
# 删除官方 envsubst 脚本，避免它把 $API_TARGET（无花括号）也替换掉导致 nginx -t 失败
RUN rm -f /docker-entrypoint.d/20-envsubst-on-templates.sh
# 复制 nginx 配置模板
COPY risk-score-h5/nginx-default.conf.template /etc/nginx/templates/default.conf.template
# 复制自定义渲染脚本：在官方 entrypoint 跑完 10/15 后执行（30 序号 > 20）
COPY docker-entrypoint.d/30-custom-envsubst.sh /docker-entrypoint.d/30-custom-envsubst.sh
RUN chmod +x /docker-entrypoint.d/30-custom-envsubst.sh
# 静态资源
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
# 官方 entrypoint 会先跑 /docker-entrypoint.d/*.sh（10/15 + 我们的 30），再执行 CMD
CMD ["nginx", "-g", "daemon off;"]
